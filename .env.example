# ==============================================================================
# CampusX - Environment Configuration Template
# NOTE: Copy this file to .env and configure values for your local environment.
# Never commit the .env file containing real secrets or API keys.
# ==============================================================================

# Application Settings
APP_NAME="CampusX"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Host and Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database Configuration
# Primary: PostgreSQL (production and local container)
# Fallback: Deterministic SQLite file inside backend/data/campusx.db
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/campusx_db"
# Fallback SQLite example: "sqlite:///C:/Users/user/Desktop/campusx/backend/data/campusx.db"

# Vector Database / RAG Configuration
VECTOR_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/campusx_db"
VECTOR_COLLECTION_NAME="campusx_rag_docs"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# AI Provider Configuration
# Options: "gemini" | "openai" | "mock"
AI_PROVIDER="mock"
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
GEMINI_MODEL="gemini-1.5-flash"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Academic & Campus Attendance Thresholds
ATTENDANCE_WARNING_THRESHOLD=75.0
ATTENDANCE_CRITICAL_THRESHOLD=65.0

# File Upload & Media Storage
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR="backend/uploads"

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=100
